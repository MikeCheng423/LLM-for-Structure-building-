{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-ledger/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "created_at", "producer_version", "artifact_hashes", "claims", "contradictions", "unresolved_fields"],
  "properties": {
    "schema_version": {"const": "evidence-ledger/v1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "created_at": {"type": "string", "minLength": 20, "maxLength": 40},
    "producer_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "artifact_hashes": {"type": "object"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "value", "evidence_type", "source_id", "locator", "confidence"],
        "properties": {
          "field": {"type": "string", "minLength": 1, "maxLength": 160},
          "value": {},
          "unit": {"type": "string", "maxLength": 32},
          "evidence_type": {"type": "string", "enum": ["reported", "user_supplied"]},
          "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "locator": {"type": "string", "minLength": 1, "maxLength": 500},
          "verbatim_span": {"type": "string", "maxLength": 2000},
          "confidence": {"type": "string", "enum": ["low", "medium", "high"]}
        }
      }
    },
    "contradictions": {"type": "array", "items": {"type": "object"}},
    "unresolved_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 160}}
  }
}
