{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supplied-evidence/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "created_at", "producer_version", "artifact_hashes", "request", "sources", "model_location", "private_external_authorized"],
  "properties": {
    "schema_version": {"const": "supplied-evidence/v1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "created_at": {"type": "string", "minLength": 20, "maxLength": 40},
    "producer_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "artifact_hashes": {"type": "object"},
    "request": {"type": "string", "minLength": 1, "maxLength": 10000},
    "model_location": {"type": "string", "enum": ["local", "external"]},
    "private_external_authorized": {"type": "boolean"},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "locator", "text"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "locator": {"type": "string", "minLength": 1, "maxLength": 500},
          "text": {"type": "string", "minLength": 1, "maxLength": 1000000},
          "private": {"type": "boolean"}
        }
      }
    }
  }
}
