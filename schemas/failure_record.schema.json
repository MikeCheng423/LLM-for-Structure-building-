{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "failure-record/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "created_at", "producer_version", "artifact_hashes", "stage", "error_code", "message"],
  "properties": {
    "schema_version": {"const": "failure-record/v1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "created_at": {"type": "string", "minLength": 20, "maxLength": 40},
    "producer_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "artifact_hashes": {"type": "object"},
    "stage": {"type": "string", "enum": ["evidence_extraction", "spec_planning", "deterministic_pipeline"]},
    "error_code": {"type": "string", "minLength": 1, "maxLength": 128},
    "message": {"type": "string", "minLength": 1, "maxLength": 1000}
  }
}
