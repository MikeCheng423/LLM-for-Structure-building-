{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalyst-spec/v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_status", "material", "model", "modifications",
    "provenance", "clarification_questions", "requested_outputs"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "task_status": {
      "type": "string",
      "enum": ["ready", "needs_clarification", "unsupported"]
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formula": {"type": "string", "minLength": 1, "maxLength": 64},
        "crystal_structure": {
          "type": "string",
          "enum": ["fcc", "bcc", "hcp", "diamond", "sc", "fluorite", "rocksalt", "wurtzite", "zincblende"]
        },
        "reference_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "lattice_parameters_angstrom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "a": {"type": "number", "exclusiveMinimum": 0.0},
            "b": {"type": "number", "exclusiveMinimum": 0.0},
            "c": {"type": "number", "exclusiveMinimum": 0.0},
            "alpha": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 180.0},
            "beta": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 180.0},
            "gamma": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 180.0}
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["bulk", "surface", "nanoparticle"]},
        "miller_indices": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {"type": "integer"}
        },
        "supercell": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {"type": "integer", "minimum": 1, "maximum": 12}
        },
        "layers": {"type": "integer", "minimum": 1, "maximum": 40},
        "vacuum_angstrom": {"type": "number", "minimum": 3.0, "maximum": 100.0},
        "shape": {"type": "string", "enum": ["icosahedron", "octahedron", "cuboctahedron"]},
        "shells": {"type": "integer", "minimum": 1, "maximum": 6},
        "lattice_constant_angstrom": {"type": "number", "exclusiveMinimum": 0.0},
        "termination": {"type": "string", "minLength": 1, "maxLength": 64},
        "periodic_boundary_conditions": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {"type": "boolean"}
        },
        "fixed_layers_from_bottom": {"type": "integer", "minimum": 0, "maximum": 40},
        "center": {"type": "boolean"},
        "atom_ordering": {"type": "string", "enum": ["ase_default"]}
      }
    },
    "modifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation"],
        "properties": {
          "operation": {"type": "string", "enum": ["make_vacancy", "substitute", "add_adsorbate", "add_supported_cluster"]},
          "selector": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "indices": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"type": "integer", "minimum": 1}
              },
              "element": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"type": "string", "minLength": 1, "maxLength": 3}
              },
              "region": {
                "type": "object", "additionalProperties": false,
                "required": ["axis", "op", "value"],
                "properties": {
                  "axis": {"type": "string", "enum": ["x", "y", "z"]},
                  "op": {"type": "string", "enum": ["<", "<=", ">", ">=", "=="]},
                  "value": {"type": "number"},
                  "fractional": {"type": "boolean"},
                  "tolerance": {"type": "number", "minimum": 0.0}
                }
              },
              "layer": {
                "type": "object", "additionalProperties": false,
                "required": ["side", "count"],
                "properties": {
                  "side": {"type": "string", "enum": ["bottom", "top"]},
                  "count": {"type": "integer", "minimum": 1},
                  "tolerance": {"type": "number", "exclusiveMinimum": 0.0}
                }
              },
              "ordinal": {"type": "integer", "minimum": 1}
            }
          },
          "element": {"type": "string", "minLength": 1, "maxLength": 3},
          "species": {"type": "string", "minLength": 1, "maxLength": 32},
          "site": {"type": "string", "enum": ["ontop", "bridge", "hollow"]},
          "site_index": {"type": "integer", "minimum": 1, "maximum": 1000},
          "height_angstrom": {"type": "number", "minimum": 0.5, "maximum": 20.0},
          "anchor": {"type": "integer", "minimum": 1, "maximum": 100},
          "orientation": {"type": "string", "minLength": 1, "maxLength": 32},
          "coverage_monolayer": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 10.0}
          ,
          "shape": {"type": "string", "enum": ["icosahedron", "octahedron", "cuboctahedron"]},
          "shells": {"type": "integer", "minimum": 1, "maximum": 6},
          "gap_angstrom": {"type": "number", "minimum": 0.5, "maximum": 20.0},
          "vacuum_angstrom": {"type": "number", "minimum": 3.0, "maximum": 100.0},
          "lattice_constant_angstrom": {"type": "number", "exclusiveMinimum": 0.0}
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "value", "evidence_type"],
        "properties": {
          "field": {"type": "string", "minLength": 1, "maxLength": 160},
          "value": {},
          "evidence_type": {
            "type": "string",
            "enum": ["reported", "derived", "assumed_default", "user_supplied", "ambiguous"]
          },
          "claim_index": {"type": "integer", "minimum": 0},
          "reason": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "clarification_questions": {
      "type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "requested_outputs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "enum": ["cif", "vasp", "xyz", "traj"]}
    }
  }
}
